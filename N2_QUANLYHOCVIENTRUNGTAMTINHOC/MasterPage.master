<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.master.cs" Inherits="N2_QUANLYHOCVIENTRUNGTAMTINHOC.MasterPage" %>
<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /> - Quản Lý Đào Tạo Tin Học</title>
    <link href="/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="/Content/css/theme.css" rel="stylesheet" />
    <style>
        .sidebar .sidebar-nav li a:hover,
        .sidebar .sidebar-nav li a:focus,
        .sidebar .sidebar-nav li a.active-orange,
        .sidebar .sidebar-nav li.active-orange > a {
            background: #FF8A26 !important;
            background-color: #FF8A26 !important;
            color: #ffffff !important;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.2s ease-in-out;
        }
        .sidebar .sidebar-nav li a:hover i,
        .sidebar .sidebar-nav li a:focus i,
        .sidebar .sidebar-nav li a.active-orange i,
        .sidebar .sidebar-nav li.active-orange > a i {
            color: #ffffff !important;
        }
        input::-ms-reveal,
        input::-ms-clear {
            display: none !important;
        }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
    <form id="form1" runat="server">
        <asp:ScriptManager runat="server" />
        <div class="app-wrapper">
            <!-- SIDEBAR TRÁI -->
            <aside id="sidebar" class="sidebar">
                <div class="sidebar-brand">
                    <i class="bi bi-mortarboard-fill fs-4 text-warning"></i>
                    <span>TRUNG TÂM TIN HỌC</span>
                </div>
                <ul class="sidebar-nav">
                    <li id="liDashboard" runat="server"><a href="/Dashboard.aspx"><i class="bi bi-speedometer2"></i> Tổng quan (Dashboard)</a></li>
                    <li id="liHocVien" runat="server"><a href="/Views/HocVien/QuanLyHocVien.aspx"><i class="bi bi-people-fill"></i> Quản lý Học viên</a></li>
                    <li id="liKhoaHoc" runat="server"><a href="/Views/KhoaHoc/QuanLyKhoaHoc.aspx"><i class="bi bi-journal-bookmark-fill"></i> Quản lý Khóa học</a></li>
                    <li id="liGiangVien" runat="server"><a href="/Views/GiangVien/QuanLyGiangVien.aspx"><i class="bi bi-person-badge-fill"></i> Quản lý Giảng viên</a></li>
                    <li id="liLopHoc" runat="server"><a href="/Views/LopHoc/QuanLyLopHoc.aspx"><i class="bi bi-easel2-fill"></i> Lớp học & Lịch học</a></li>
                    <li id="liDangKy" runat="server"><a href="/Views/DangKy/QuanLyDangKy.aspx"><i class="bi bi-card-checklist"></i> Đăng ký Khóa học</a></li>
                    <li id="liPhieuThu" runat="server"><a href="/Views/PhieuThu/QuanLyPhieuThu.aspx"><i class="bi bi-receipt-cutoff"></i> Quản lý Phiếu thu</a></li>
                    <li id="liKyThi" runat="server"><a href="/Views/KyThi/QuanLyKyThi.aspx"><i class="bi bi-calendar2-check-fill"></i> Kỳ thi & Điểm thi</a></li>
                    <li id="liChungChi" runat="server"><a href="/Views/ChungChi/QuanLyChungChi.aspx"><i class="bi bi-award-fill"></i> Cấp Chứng chỉ</a></li>
                    <li id="liBaoCao" runat="server"><a href="/Views/BaoCao/BaoCaoThongKe.aspx"><i class="bi bi-bar-chart-line-fill"></i> Báo cáo & Thống kê</a></li>
                    <li id="liCaiDat" runat="server"><a href="/Views/CaiDat/CaiDatHeThong.aspx"><i class="bi bi-gear-wide-connected"></i> Cài đặt & Sao lưu DB</a></li>
                    <li class="mt-2 border-top border-secondary pt-2">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#modalHuongDanSuDung">
                            <i class="bi bi-question-circle-fill text-white"></i> Hướng dẫn sử dụng
                        </a>
                    </li>
                </ul>
            </aside>

            <!-- PANEL CHÍNH -->
            <div class="main-panel">
                <header class="top-header">
                    <div class="d-flex align-items-center gap-3">
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="toggleSidebar()">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <h6 class="mb-0 fw-bold text-primary d-none d-md-block">
                            <asp:Literal ID="litTenTrungTam" runat="server" />
                        </h6>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-primary-subtle text-primary px-3 py-2">
                            <i class="bi bi-person-circle me-1"></i>
                            <asp:Literal ID="litNguoiDung" runat="server" />
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalDoiMatKhau" title="Đổi mật khẩu">
                            <i class="bi bi-key"></i> Đổi MK
                        </button>
                        <button type="button" class="btn btn-sm btn-orange" data-bs-toggle="modal" data-bs-target="#modalDangXuat">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </button>
                    </div>
                </header>

                <main class="content-area">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>

                <footer class="app-footer">
                    &copy; <%= DateTime.Now.Year %> Hệ thống Quản lý Học viên Trung tâm Tin học.
                </footer>
            </div>
        </div>

        <!-- POPUP XÁC NHẬN ĐĂNG XUẤT -->
        <div class="modal fade" id="modalDangXuat" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-box-arrow-right me-2"></i>Xác nhận Đăng xuất
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-4 text-center">
                        <i class="bi bi-question-circle text-warning display-4 mb-3 d-block"></i>
                        <p class="fs-5 mb-0">Bạn có chắc muốn đăng xuất khỏi hệ thống không?</p>
                    </div>
                    <div class="modal-footer justify-content-center border-0 pb-4">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                        <asp:LinkButton ID="btnDangXuat" runat="server" CssClass="btn btn-orange px-4" OnClick="btnDangXuat_Click">
                            <i class="bi bi-check-lg me-1"></i> Đồng ý
                        </asp:LinkButton>
                    </div>
                </div>
            </div>
        </div>

        <!-- POPUP ĐỔI MẬT KHẨU (HỖ TRỢ CHẾ ĐỘ BẮT BUỘC ĐỔI LẦN ĐẦU) -->
        <div class="modal fade" id="modalDoiMatKhau" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold" id="titleDoiMK"><i class="bi bi-key-fill me-2"></i>Đổi Mật khẩu Tài khoản</h5>
                        <button type="button" class="btn-close btn-close-white" id="btnCloseDoiMK" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="alertBatBuocDoiMK" class="alert alert-warning py-2 small fw-semibold d-none">
                            <i class="bi bi-shield-exclamation me-1"></i> Đây là lần đăng nhập đầu tiên. Vui lòng đổi mật khẩu mới (khác SĐT, tối thiểu 6 ký tự) để tiếp tục!
                        </div>
                        <%-- Chỉ vùng báo lỗi nằm trong UpdatePanel: bấm "Cập nhật" gửi bằng AJAX,
                             pop-up KHÔNG bị tải lại/đóng, các ô nhập vẫn giữ nguyên giá trị --%>
                        <asp:UpdatePanel ID="upLoiDoiMK" runat="server" UpdateMode="Conditional">
                            <ContentTemplate>
                                <asp:Panel ID="pnlLoiDoiMK" runat="server" ClientIDMode="Static"
                                    CssClass="alert alert-danger py-2 small fw-semibold mb-2 d-none">
                                    <i class="bi bi-exclamation-circle-fill me-1"></i>
                                    <span id="spanLoiDoiMK"><asp:Literal ID="litLoiDoiMK" runat="server" /></span>
                                </asp:Panel>
                            </ContentTemplate>
                            <Triggers>
                                <asp:AsyncPostBackTrigger ControlID="btnLuuMatKhau" EventName="Click" />
                            </Triggers>
                        </asp:UpdatePanel>

                        <div class="mb-2">
                            <label class="small fw-bold">Mật khẩu hiện tại (SĐT nếu đăng nhập lần đầu) (*)</label>
                            <div class="input-group">
                                <asp:TextBox ID="txtMKCu" runat="server" ClientIDMode="Static" TextMode="Password"
                                    CssClass="form-control" autocomplete="new-password" oninput="anLoiDoiMK();" />
                                <button type="button" class="btn btn-outline-secondary" tabindex="-1" onclick="toggleHienMatKhau('txtMKCu', this)" title="Hiện/Ẩn mật khẩu">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="small fw-bold">Mật khẩu mới (*)</label>
                            <div class="input-group">
                                <asp:TextBox ID="txtMKMoi" runat="server" ClientIDMode="Static" TextMode="Password"
                                    CssClass="form-control" autocomplete="new-password" oninput="anLoiDoiMK();" />
                                <button type="button" class="btn btn-outline-secondary" tabindex="-1" onclick="toggleHienMatKhau('txtMKMoi', this)" title="Hiện/Ẩn mật khẩu">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="small fw-bold">Xác nhận mật khẩu mới (*)</label>
                            <div class="input-group">
                                <asp:TextBox ID="txtMKXacNhan" runat="server" ClientIDMode="Static" TextMode="Password"
                                    CssClass="form-control" autocomplete="new-password" oninput="anLoiDoiMK();" />
                                <button type="button" class="btn btn-outline-secondary" tabindex="-1" onclick="toggleHienMatKhau('txtMKXacNhan', this)" title="Hiện/Ẩn mật khẩu">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" id="btnHuyDoiMK" data-bs-dismiss="modal">Hủy</button>
                        <asp:Button ID="btnLuuMatKhau" runat="server" Text="Cập nhật Mật khẩu" CssClass="btn btn-primary-gradient fw-bold"
                            OnClientClick="if (!kiemTraFormDoiMK()) return false;" OnClick="btnLuuMatKhau_Click" CausesValidation="false" UseSubmitBehavior="false" />
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL HƯỚNG DẪN SỬ DỤNG -->
        <%
            string qHelp = N2_QUANLYHOCVIENTRUNGTAMTINHOC.MasterPage.ChuanHoaQuyen(Session["Quyen"]);
            bool isHelpAdmin = qHelp == "Admin";
            bool isHelpGV = qHelp == "GiangVien";
            bool isHelpHV = qHelp == "HocVien";
            bool isHelpNV = qHelp == "NhanVien";
        %>
        <div class="modal fade" id="modalHuongDanSuDung" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header text-white" style="background: linear-gradient(135deg, #0755A6, #1677D2);">
                        <h5 class="modal-title fw-bold"><i class="bi bi-book-half me-2"></i>Cẩm nang Hướng dẫn Sử dụng & Giải thích Nút Chức năng Hệ thống</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <% if (isHelpAdmin) { %>
                        <div class="mb-3"><span class="badge bg-primary fs-6 px-3 py-2">Phân quyền: Quản trị viên Hệ thống (Admin)</span></div>
                        <div class="border rounded p-3 bg-light text-small">Quản lý toàn bộ hệ thống đào tạo, nhân sự, tài chính và sao lưu dữ liệu.</div>
                        <% } else if (isHelpNV) { %>
                        <div class="mb-3"><span class="badge bg-primary fs-6 px-3 py-2">Phân quyền: Nhân viên Giáo vụ</span></div>
                        <div class="border rounded p-3 bg-light text-small">Nghiệp vụ xếp lớp, thu học phí QR, hoàn tiền và tổ chức thi.</div>
                        <% } else if (isHelpGV) { %>
                        <div class="mb-3"><span class="badge bg-primary fs-6 px-3 py-2">Phân quyền: Giảng viên</span></div>
                        <div class="border rounded p-3 bg-light text-small">Điểm danh chuyên cần và nhập điểm thi các lớp phụ trách.</div>
                        <% } else { %>
                        <div class="mb-3"><span class="badge bg-primary fs-6 px-3 py-2">Phân quyền: Học viên</span></div>
                        <div class="border rounded p-3 bg-light text-small">Tra cứu lịch học, đăng ký khóa học, đóng học phí QR và xem chứng chỉ.</div>
                        <% } %>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Đóng hướng dẫn</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- POPUP THÔNG BÁO CHUNG -->
        <div class="modal fade" id="modalThongBaoChung" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered modal-sm">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-info text-white py-2">
                        <h6 class="modal-title fw-bold"><i class="bi bi-info-circle me-2"></i>Thông báo hệ thống</h6>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center py-4">
                        <span id="msgThongBaoChung" class="fw-semibold"></span>
                    </div>
                    <div class="modal-footer justify-content-center py-2 bg-light">
                        <button type="button" class="btn btn-sm btn-secondary px-4" data-bs-dismiss="modal">Đóng</button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // @ts-nocheck
        document.addEventListener("DOMContentLoaded", function () {
            var sidebar = document.getElementById('sidebar');
            var isCollapsed = localStorage.getItem('sidebar_collapsed');
            if (sidebar && isCollapsed === 'true') {
                sidebar.classList.add('collapsed');
            }
        });

        // Khi đóng pop-up Đổi mật khẩu (Hủy / thành công): xóa trắng ô nhập và ẩn lỗi
        document.addEventListener("DOMContentLoaded", function () {
            var m = document.getElementById('modalDoiMatKhau');
            if (!m) return;
            m.addEventListener('hidden.bs.modal', function () {
                ['txtMKCu', 'txtMKMoi', 'txtMKXacNhan'].forEach(function (id) {
                    var e = document.getElementById(id);
                    if (e) { e.value = ''; e.type = 'password'; }
                });
                m.querySelectorAll('.bi-eye-slash').forEach(function (i) {
                    i.classList.remove('bi-eye-slash');
                    i.classList.add('bi-eye');
                });
                anLoiDoiMK();
            });
        });

        function toggleHienMatKhau(inputId, btn) {
            var inp = document.getElementById(inputId);
            if (!inp) return;
            var icon = btn.querySelector('i');
            if (inp.type === 'password') {
                inp.type = 'text';
                if (icon) {
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                }
            } else {
                inp.type = 'password';
                if (icon) {
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                }
            }
        }

        function anLoiDoiMK() {
            var pnl = document.getElementById('pnlLoiDoiMK');
            if (pnl && !pnl.classList.contains('d-none')) {
                pnl.classList.add('d-none');
            }
        }

        function baoLoiTrongModalDoiMK(msg) {
            var pnl = document.getElementById('pnlLoiDoiMK');
            var span = document.getElementById('spanLoiDoiMK');
            if (pnl && span) {
                span.innerText = msg;
                pnl.classList.remove('d-none');
            }
        }

        function kiemTraFormDoiMK() {
            anLoiDoiMK();
            var mkCu = (document.getElementById('txtMKCu')?.value || '').trim();
            var mkMoi = (document.getElementById('txtMKMoi')?.value || '').trim();
            var mkXN = (document.getElementById('txtMKXacNhan')?.value || '').trim();

            if (!mkCu) {
                baoLoiTrongModalDoiMK('Vui lòng nhập Mật khẩu hiện tại!');
                document.getElementById('txtMKCu')?.focus();
                return false;
            }
            if (!mkMoi) {
                baoLoiTrongModalDoiMK('Vui lòng nhập Mật khẩu mới!');
                document.getElementById('txtMKMoi')?.focus();
                return false;
            }
            if (mkMoi.indexOf(' ') !== -1) {
                baoLoiTrongModalDoiMK('Mật khẩu mới không được chứa khoảng trắng!');
                document.getElementById('txtMKMoi')?.focus();
                return false;
            }
            if (mkMoi.length < 6 || mkMoi.length > 50) {
                baoLoiTrongModalDoiMK('Mật khẩu mới phải từ 6 đến 50 ký tự!');
                document.getElementById('txtMKMoi')?.focus();
                return false;
            }
            if (mkMoi === mkCu) {
                baoLoiTrongModalDoiMK('Mật khẩu mới không được trùng với mật khẩu hiện tại!');
                document.getElementById('txtMKMoi')?.focus();
                return false;
            }
            if (!mkXN) {
                baoLoiTrongModalDoiMK('Vui lòng nhập Xác nhận mật khẩu mới!');
                document.getElementById('txtMKXacNhan')?.focus();
                return false;
            }
            if (mkMoi !== mkXN) {
                baoLoiTrongModalDoiMK('Xác nhận mật khẩu mới không khớp!');
                document.getElementById('txtMKXacNhan')?.focus();
                return false;
            }
            return true;
        }

        function moModalDoiMKBatBuoc() {
            var check = function () {
                var el = document.getElementById('modalDoiMatKhau');
                if (el && window.bootstrap) {
                    var btnClose = document.getElementById('btnCloseDoiMK');
                    var btnHuy = document.getElementById('btnHuyDoiMK');
                    var alertBox = document.getElementById('alertBatBuocDoiMK');
                    var title = document.getElementById('titleDoiMK');

                    if (btnClose) btnClose.style.display = 'none';
                    if (btnHuy) btnHuy.style.display = 'none';
                    if (alertBox) alertBox.classList.remove('d-none');
                    if (title) title.innerHTML = '<i class="bi bi-shield-lock-fill me-2"></i>Yêu cầu Đổi Mật khẩu Lần đầu';

                    var modal = window.bootstrap.Modal.getOrCreateInstance(el, {
                        backdrop: 'static',
                        keyboard: false
                    });
                    modal.show();
                } else {
                    setTimeout(check, 100);
                }
            };
            check();
        }

        function hienThiThongBaoMaster(msg, moLaiDoiMK, batBuoc) {
            var tryShow = function () {
                if (!window.bootstrap) {
                    setTimeout(tryShow, 80);
                    return;
                }
                if (moLaiDoiMK) {
                    baoLoiTrongModalDoiMK(msg);
                    if (batBuoc) {
                        moModalDoiMKBatBuoc();
                    } else {
                        var mDoiMK = document.getElementById('modalDoiMatKhau');
                        if (mDoiMK) window.bootstrap.Modal.getOrCreateInstance(mDoiMK).show();
                    }
                } else {
                    var modalEl = document.getElementById('modalThongBaoChung');
                    var msgEl = document.getElementById('msgThongBaoChung');
                    if (modalEl && msgEl) {
                        msgEl.innerText = msg;
                        window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    }
                }
            };
            tryShow();
        }

        function toggleSidebar() {
            var sidebar = document.getElementById('sidebar');
            if (sidebar) {
                sidebar.classList.toggle('collapsed');
                var isNowCollapsed = sidebar.classList.contains('collapsed');
                localStorage.setItem('sidebar_collapsed', String(isNowCollapsed));
            }
        }
    </script>
</body>
</html>