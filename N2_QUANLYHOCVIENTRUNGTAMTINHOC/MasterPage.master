<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterPage.master.cs" Inherits="N2_QUANLYHOCVIENTRUNGTAMTINHOC.MasterPage" %>
<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server" /> - Quản Lý Đào Tạo Tin Học</title>
    <link href="/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="/Content/css/theme.css" rel="stylesheet" />
    <style>
        /* Tô nền cam chữ trắng khi di chuột (hover), khi bấm vào hoặc khi đang ở trang hiện hành */
        .sidebar .sidebar-nav li a:hover,
        .sidebar .sidebar-nav li a:focus,
        .sidebar .sidebar-nav li a.active-orange,
        .sidebar .sidebar-nav li.active-orange > a {
            background: #FF8A26 !important;
            background-color: #FF8A26 !important;
            color: #ffffff !important;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.2s ease-in-out;
        }
        .sidebar .sidebar-nav li a:hover i,
        .sidebar .sidebar-nav li a:focus i,
        .sidebar .sidebar-nav li a.active-orange i,
        .sidebar .sidebar-nav li.active-orange > a i {
            color: #ffffff !important;
        }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
    <form id="form1" runat="server">
        <div class="app-wrapper">
            <!-- SIDEBAR TRÁI -->
            <aside id="sidebar" class="sidebar">
                <div class="sidebar-brand">
                    <i class="bi bi-mortarboard-fill fs-4 text-warning"></i>
                    <span>TRUNG TÂM TIN HỌC</span>
                </div>
                <ul class="sidebar-nav">
                    <li id="liDashboard" runat="server"><a href="/Dashboard.aspx"><i class="bi bi-speedometer2"></i> Tổng quan (Dashboard)</a></li>
                    <li id="liHocVien" runat="server"><a href="/Views/HocVien/QuanLyHocVien.aspx"><i class="bi bi-people-fill"></i> Quản lý Học viên</a></li>
                    <li id="liKhoaHoc" runat="server"><a href="/Views/KhoaHoc/QuanLyKhoaHoc.aspx"><i class="bi bi-journal-bookmark-fill"></i> Quản lý Khóa học</a></li>
                    <li id="liGiangVien" runat="server"><a href="/Views/GiangVien/QuanLyGiangVien.aspx"><i class="bi bi-person-badge-fill"></i> Quản lý Giảng viên</a></li>
                    <li id="liLopHoc" runat="server"><a href="/Views/LopHoc/QuanLyLopHoc.aspx"><i class="bi bi-easel2-fill"></i> Lớp học & Lịch học</a></li>
                    <li id="liDangKy" runat="server"><a href="/Views/DangKy/QuanLyDangKy.aspx"><i class="bi bi-card-checklist"></i> Đăng ký Khóa học</a></li>
                    <li id="liPhieuThu" runat="server"><a href="/Views/PhieuThu/QuanLyPhieuThu.aspx"><i class="bi bi-receipt-cutoff"></i> Quản lý Phiếu thu</a></li>
                    <li id="liKyThi" runat="server"><a href="/Views/KyThi/QuanLyKyThi.aspx"><i class="bi bi-calendar2-check-fill"></i> Kỳ thi & Điểm thi</a></li>
                    <li id="liChungChi" runat="server"><a href="/Views/ChungChi/QuanLyChungChi.aspx"><i class="bi bi-award-fill"></i> Cấp Chứng chỉ</a></li>
                    <li id="liBaoCao" runat="server"><a href="/Views/BaoCao/BaoCaoThongKe.aspx"><i class="bi bi-bar-chart-line-fill"></i> Báo cáo & Thống kê</a></li>
                    <li id="liCaiDat" runat="server"><a href="/Views/CaiDat/CaiDatHeThong.aspx"><i class="bi bi-gear-wide-connected"></i> Cài đặt & Sao lưu DB</a></li>
                    <li class="mt-2 border-top border-secondary pt-2">
                        <a href="#" data-bs-toggle="modal" data-bs-target="#modalHuongDanSuDung">
                            <i class="bi bi-question-circle-fill text-white"></i> Hướng dẫn sử dụng
                        </a>
                    </li>
                </ul>
            </aside>

            <!-- PANEL CHÍNH -->
            <div class="main-panel">
                <header class="top-header">
                    <div class="d-flex align-items-center gap-3">
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="toggleSidebar()">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <h6 class="mb-0 fw-bold text-primary d-none d-md-block">
                            <asp:Literal ID="litTenTrungTam" runat="server" />
                        </h6>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-primary-subtle text-primary px-3 py-2">
                            <i class="bi bi-person-circle me-1"></i>
                            <asp:Literal ID="litNguoiDung" runat="server" />
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#modalDoiMatKhau" title="Đổi mật khẩu">
                            <i class="bi bi-key"></i> Đổi MK
                        </button>
                        <button type="button" class="btn btn-sm btn-orange" data-bs-toggle="modal" data-bs-target="#modalDangXuat">
                            <i class="bi bi-box-arrow-right"></i> Đăng xuất
                        </button>
                    </div>
                </header>

                <main class="content-area">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>

                <footer class="app-footer">
                    &copy; <%= DateTime.Now.Year %> Hệ thống Quản lý Học viên Trung tâm Tin học.
                </footer>
            </div>
        </div>

        <!-- POPUP XÁC NHẬN ĐĂNG XUẤT -->
        <div class="modal fade" id="modalDangXuat" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold">
                            <i class="bi bi-box-arrow-right me-2"></i>Xác nhận Đăng xuất
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-4 text-center">
                        <i class="bi bi-question-circle text-warning display-4 mb-3 d-block"></i>
                        <p class="fs-5 mb-0">Bạn có chắc muốn đăng xuất khỏi hệ thống không?</p>
                    </div>
                    <div class="modal-footer justify-content-center border-0 pb-4">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hủy</button>
                        <asp:LinkButton ID="btnDangXuat" runat="server" CssClass="btn btn-orange px-4" OnClick="btnDangXuat_Click">
                            <i class="bi bi-check-lg me-1"></i> Đồng ý
                        </asp:LinkButton>
                    </div>
                </div>
            </div>
        </div>

        <!-- POPUP ĐỔI MẬT KHẨU CHO HỌC VIÊN / GIẢNG VIÊN / ADMIN -->
        <div class="modal fade" id="modalDoiMatKhau" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold"><i class="bi bi-key-fill me-2"></i>Đổi Mật khẩu Tài khoản</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">
                            <label class="small fw-bold">Mật khẩu hiện tại (*)</label>
                            <asp:TextBox ID="txtMKCu" runat="server" TextMode="Password" CssClass="form-control" />
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold">Mật khẩu mới (*)</label>
                            <asp:TextBox ID="txtMKMoi" runat="server" TextMode="Password" CssClass="form-control" />
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold">Xác nhận mật khẩu mới (*)</label>
                            <asp:TextBox ID="txtMKXacNhan" runat="server" TextMode="Password" CssClass="form-control" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <asp:Button ID="btnLuuMatKhau" runat="server" Text="Cập nhật Mật khẩu" CssClass="btn btn-primary-gradient" OnClick="btnLuuMatKhau_Click" />
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL HƯỚNG DẪN SỬ DỤNG HIỂN THỊ THEO ĐÚNG PHÂN QUYỀN ĐANG ĐĂNG NHẬP -->
        <%
            string qHelp = (Session["Quyen"] != null ? Session["Quyen"].ToString().Trim() : "Admin");
            bool isHelpAdmin = qHelp.Equals("Admin", StringComparison.OrdinalIgnoreCase);
            bool isHelpGV = qHelp.Equals("GiangVien", StringComparison.OrdinalIgnoreCase) || qHelp.Equals("Giảng viên", StringComparison.OrdinalIgnoreCase);
            bool isHelpHV = qHelp.Equals("HocVien", StringComparison.OrdinalIgnoreCase) || qHelp.Equals("Học viên", StringComparison.OrdinalIgnoreCase) || qHelp.Equals("SinhVien", StringComparison.OrdinalIgnoreCase);
            bool isHelpNV = !isHelpAdmin && !isHelpGV && !isHelpHV;
        %>
        <div class="modal fade" id="modalHuongDanSuDung" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content border-0 shadow-lg">
                    <div class="modal-header text-white" style="background: linear-gradient(135deg, #0755A6, #1677D2);">
                        <h5 class="modal-title fw-bold"><i class="bi bi-book-half me-2"></i>Cẩm nang Hướng dẫn Sử dụng & Giải thích Nút Chức năng Hệ thống</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <% if (isHelpAdmin) { %>
                        <!-- CHỈ HIỂN THỊ CHO ADMIN -->
                        <div class="mb-3">
                            <span class="badge bg-primary fs-6 px-3 py-2"><i class="bi bi-shield-lock-fill me-2"></i>Tài khoản: Quản trị viên (Admin)</span>
                        </div>
                        <div class="border rounded p-3 bg-light">
                            <h6 class="fw-bold text-primary mb-3">Toàn quyền quản trị hệ thống, nhân sự, tài chính và đào tạo:</h6>
                            <div class="row g-3 small">
                                <div class="col-md-6">
                                    <div class="p-3 bg-white rounded border h-100">
                                        <strong class="text-dark d-block mb-2"><i class="bi bi-easel2 me-1 text-primary"></i>Quản lý Lớp học & Thời khóa biểu:</strong>
                                        <ul class="mb-0 ps-3">
                                            <li><span class="badge bg-warning text-dark">Thêm Lớp & Lịch</span>: Mở lớp học phần mới và gán Ca học, Thứ, Giờ, Phòng Lab.</li>
                                            <li><span class="badge bg-primary">Cập nhật Lớp & Đổi Lịch</span>: Sửa thông tin lớp hoặc đổi phòng, đổi ca học.</li>
                                            <li><strong>Bấm trực tiếp vào ô lớp trên Bảng Thời Khóa Biểu</strong>: Mở popup đổi nhanh lịch học và cảnh báo <span class="badge bg-danger">TRÙNG LỊCH HỌC!</span>.</li>
                                            <li><span class="badge bg-outline-danger text-danger border border-danger"><i class="bi bi-trash"></i> Xóa</span>: Xóa lớp học (chỉ Admin mới có nút này và chỉ xóa được lớp chưa có học viên đăng ký).</li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 bg-white rounded border h-100">
                                        <strong class="text-dark d-block mb-2"><i class="bi bi-card-checklist me-1 text-primary"></i>Đăng ký Học phần & Xếp lớp (&lt; 10 HV):</strong>
                                        <ul class="mb-0 ps-3">
                                            <li><span class="badge bg-primary">1. Ghép toàn bộ HV sang Lớp đích</span>: Chuyển toàn bộ học viên từ lớp thiếu (&lt; 10 HV) sang lớp đích cùng khóa còn chỗ.</li>
                                            <li><span class="badge bg-success">2. Duyệt mở lớp đặc cách</span>: Cho phép lớp mở học chính thức dù chưa đủ 10 học viên.</li>
                                            <li><span class="badge bg-danger">3. Hủy lớp & Bảo lưu học phí</span>: Hủy lớp không đủ sĩ số và bảo lưu học phí cho học viên chờ xếp lớp sau.</li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 bg-white rounded border h-100">
                                        <strong class="text-dark d-block mb-2"><i class="bi bi-journal-check me-1 text-primary"></i>Kỳ thi, Chứng chỉ & Báo cáo:</strong>
                                        <ul class="mb-0 ps-3">
                                            <li><span class="badge bg-warning text-dark">Tạo Kỳ thi</span>: Lên lịch thi theo Khóa học, Đợt 1/Đợt 2 và Niên khóa.</li>
                                            <li><span class="badge bg-warning text-dark">Cấp Chứng chỉ</span> / <span class="badge bg-success"><i class="bi bi-printer"></i> In</span>: Cấp mã số hiệu tự động cho học viên Đạt và in phôi chứng chỉ có dấu mộc.</li>
                                            <li><span class="badge bg-success"><i class="bi bi-file-earmark-excel-fill"></i> Xuất Excel</span>: Xuất danh sách học viên theo khóa/lớp/học phí và báo cáo doanh thu theo năm.</li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-3 bg-white rounded border h-100">
                                        <strong class="text-dark d-block mb-2"><i class="bi bi-gear-fill me-1 text-primary"></i>Cài đặt Hệ thống & Danh mục:</strong>
                                        <ul class="mb-0 ps-3">
                                            <li>Quản lý danh mục <strong>Học viên, Giảng viên, Khóa học</strong>.</li>
                                            <li>Phân quyền tài khoản người dùng và cấu hình thông tin Trung tâm (chỉ Admin mới thấy mục Cài đặt).</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% } else if (isHelpNV) { %>
                        <!-- CHỈ HIỂN THỊ CHO NHÂN VIÊN -->
                        <div class="mb-3">
                            <span class="badge bg-primary fs-6 px-3 py-2"><i class="bi bi-person-badge-fill me-2"></i>Tài khoản: Nhân viên Giáo vụ</span>
                        </div>
                        <div class="border rounded p-3 bg-light">
                            <h6 class="fw-bold text-primary mb-3">Nghiệp vụ Giáo vụ, Tư vấn Ghi danh & Thu học phí:</h6>
                            <ul class="small lh-lg mb-0">
                                <li><strong>Mở lớp & Xếp Thời khóa biểu:</strong> Sử dụng nút <span class="badge bg-warning text-dark">Thêm Lớp & Lịch</span>, <span class="badge bg-primary">Cập nhật Lớp & Đổi Lịch</span> hoặc bấm trực tiếp vào lớp trên lưới Thời khóa biểu để điều chỉnh lịch (không có nút Xóa lớp của Admin).</li>
                                <li><strong>Ghi danh & Xếp lớp:</strong> Bấm <span class="badge bg-warning text-dark">Chọn lớp này</span> trên bảng lớp đang mở -&gt; Kiểm tra học phí tự động -&gt; Bấm <span class="badge bg-warning text-dark">Xác nhận Đăng ký</span> (hệ thống tự động chặn trùng lịch học và gợi ý lớp khác).</li>
                                <li><strong>Đổi lớp & Xử lý lớp thiếu (&lt; 10 HV):</strong> Bấm nút <span class="badge bg-outline-primary text-primary border border-primary"><i class="bi bi-arrow-left-right"></i></span> rồi bấm <span class="badge bg-primary">Đổi Lớp</span>, hoặc dùng khung xử lý ghép lớp / mở đặc cách.</li>
                                <li><strong>Thu học phí QR & Lập phiếu thu:</strong> Bấm <span class="badge bg-success"><i class="bi bi-qr-code-scan"></i> Đóng HP</span> để tạo mã VietQR tự động theo số tiền còn nợ, tải ảnh biên lai và xác nhận thu tiền.</li>
                                <li><strong>Tổ chức kỳ thi & Cấp chứng chỉ:</strong> Tạo đợt thi, nhập điểm, xét loại tự động và in chứng chỉ cho học viên.</li>
                            </ul>
                        </div>
                        <% } else if (isHelpGV) { %>
                        <!-- CHỈ HIỂN THỊ CHO GIẢNG VIÊN -->
                        <div class="mb-3">
                            <span class="badge bg-primary fs-6 px-3 py-2"><i class="bi bi-easel2-fill me-2"></i>Tài khoản: Giảng viên</span>
                        </div>
                        <div class="border rounded p-3 bg-light">
                            <h6 class="fw-bold text-primary mb-3">Nghiệp vụ Giảng dạy, Điểm danh Chuyên cần & Chấm điểm Lớp phụ trách:</h6>
                            <ul class="small lh-lg mb-0">
                                <li><strong>Xem Lịch giảng dạy:</strong> Tại mục <em>Lớp học & Lịch học</em>, giảng viên chỉ thấy danh sách các lớp và lưới Thời khóa biểu của chính mình phụ trách (không hiển thị trang Dashboard hay các lớp của giảng viên khác).</li>
                                <li><strong>Điểm danh Học viên (<span class="badge bg-success"><i class="bi bi-person-check-fill"></i> Điểm danh</span>):</strong>
                                    <ul>
                                        <li>Chọn Ngày điểm danh -&gt; Tích trạng thái: <strong>Có mặt</strong>, <strong>Vắng phép</strong> (-1 điểm CC), hoặc <strong>Vắng không phép</strong> (-2 điểm CC) -&gt; Bấm <span class="badge bg-success">Lưu kết quả Điểm danh</span>.</li>
                                        <li>Hệ thống tự động gắn nhãn <span class="badge bg-warning text-dark">Cảnh báo: Nghỉ 2 buổi</span> và <span class="badge bg-danger">Cấm thi (Nghỉ &ge; 3 buổi)</span> kèm tỷ lệ % số buổi vắng theo thời lượng khóa học.</li>
                                    </ul>
                                </li>
                                <li><strong>Chấm điểm Học viên (Mục Kỳ thi & Điểm thi):</strong>
                                    <ul>
                                        <li>Giảng viên <strong>không được tạo kỳ thi</strong> (khung Tổ chức Kỳ thi đã được ẩn).</li>
                                        <li>Chỉ hiển thị các Kỳ thi và Học viên thuộc lớp do giảng viên đó giảng dạy.</li>
                                        <li>Điểm chuyên cần (20%) được tự động tính từ dữ liệu Điểm danh. Giảng viên nhập Điểm thi (80%) rồi bấm <span class="badge bg-warning text-dark">Thêm mới & Tính ĐTB</span>, <span class="badge bg-primary">Cập nhật Điểm</span>, hoặc bấm <span class="badge bg-success">Nhập điểm hàng loạt</span> để nhập nhanh cho cả lớp.</li>
                                    </ul>
                                </li>
                            </ul>
                        </div>
                        <% } else { %>
                        <!-- CHỈ HIỂN THỊ CHO HỌC VIÊN -->
                        <div class="mb-3">
                            <span class="badge bg-primary fs-6 px-3 py-2"><i class="bi bi-mortarboard-fill me-2"></i>Tài khoản: Học viên</span>
                        </div>
                        <div class="border rounded p-3 bg-light">
                            <h6 class="fw-bold text-primary mb-3">Tra cứu Lịch học, Đăng ký Học phần, Đóng học phí QR & Xem Kết quả:</h6>
                            <ul class="small lh-lg mb-0">
                                <li><strong>Lớp học & Lịch học:</strong> Xem danh sách các lớp đã đăng ký và Bảng Thời khóa biểu trong tuần của cá nhân.</li>
                                <li><strong>Đăng ký Khóa học & Đóng Học phí:</strong>
                                    <ul>
                                        <li>Bấm <span class="badge bg-warning text-dark">Chọn lớp này</span> ở danh sách lớp đang mở (&lt; 10 HV) -&gt; Bấm <span class="badge bg-warning text-dark">Xác nhận Đăng ký</span>.</li>
                                        <li>Bấm nút <span class="badge bg-success"><i class="bi bi-qr-code-scan"></i> Đóng HP</span> -&gt; Quét mã QR chuyển khoản đúng số tiền & nội dung -&gt; Tải ảnh chụp màn hình biên lai lên và bấm <span class="badge bg-success">Gửi Ảnh & Xác nhận Đã chuyển khoản</span>.</li>
                                    </ul>
                                </li>
                                <li><strong>Kỳ thi & Điểm thi:</strong> Tra cứu lịch thi, ngày thi, điểm tổng kết và kết quả (Đạt / Không đạt) của các môn đã đăng ký.</li>
                                <li><strong>Chứng chỉ cá nhân:</strong> Xem danh sách chứng chỉ đã được cấp và bấm nút <span class="badge bg-outline-success text-success border border-success"><i class="bi bi-printer"></i></span> để tải / in bản sao chứng chỉ.</li>
                            </ul>
                        </div>
                        <% } %>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Đóng hướng dẫn</button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // @ts-nocheck
        document.addEventListener("DOMContentLoaded", function () {
            var sidebar = document.getElementById('sidebar');
            var isCollapsed = localStorage.getItem('sidebar_collapsed');

            if (sidebar && isCollapsed === 'true') {
                sidebar.classList.add('collapsed');
            }

            // Tự động tô nền cam + chữ trắng cho mục Menu trái tương ứng với trang đang mở hoặc khi vừa bấm vào
            var currentPath = window.location.pathname.toLowerCase();
            var navLinks = document.querySelectorAll('.sidebar .sidebar-nav li a');
            navLinks.forEach(function (link) {
                var href = (link.getAttribute('href') || '').toLowerCase();
                if (href && href !== '#' && currentPath.indexOf(href.replace('~', '')) !== -1) {
                    link.classList.add('active-orange');
                    if (link.parentElement) link.parentElement.classList.add('active-orange');
                }

                link.addEventListener('click', function () {
                    navLinks.forEach(function (l) {
                        l.classList.remove('active-orange');
                        if (l.parentElement) l.parentElement.classList.remove('active-orange');
                    });
                    this.classList.add('active-orange');
                    if (this.parentElement) this.parentElement.classList.add('active-orange');
                });
            });
        });

        function toggleSidebar() {
            var sidebar = document.getElementById('sidebar');
            if (sidebar) {
                sidebar.classList.toggle('collapsed');
                var isNowCollapsed = sidebar.classList.contains('collapsed');
                localStorage.setItem('sidebar_collapsed', String(isNowCollapsed));
            }
}
// Sửa triệt để lỗi ấn Enter ở mọi ô tìm kiếm kích nhầm nút Thêm/Đăng ký đầu form
document.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && e.target && e.target.tagName === 'INPUT') {
        var inp = e.target;
        var type = (inp.type || '').toLowerCase();
        if (type !== 'text' && type !== 'search') return;

        var ph = (inp.placeholder || '').toLowerCase();
        var id = (inp.id || '').toLowerCase();
        if (ph.indexOf('tìm') !== -1 || id.indexOf('tim') !== -1 || type === 'search') {
            e.preventDefault();
            var container = inp.closest('.d-flex, .input-group, .card-header, .row') || inp.parentElement;
            if (container) {
                var btn = container.querySelector('input[type="submit"], button[type="submit"], .btn-primary-gradient');
                if (btn) btn.click();
            }
        }
    }
});
    </script>

</body>
</html>