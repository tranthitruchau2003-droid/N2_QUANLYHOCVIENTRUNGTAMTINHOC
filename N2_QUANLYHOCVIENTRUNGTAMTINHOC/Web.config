<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<connectionStrings>
		<add name="QuanLyDaoTao"
			 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=QuanLyDaoTao;Integrated Security=True;Encrypt=False"
			 providerName="System.Data.SqlClient"/>
	</connectionStrings>
	<appSettings>
		<add key="TenTrungTam" value="TRUNG TÂM TIN HỌC NGÔI SAO VIỆT" />
		<add key="DiaChiTrungTam" value="Số 123 Đường 3/2, Quận Ninh Kiều, TP. Cần Thơ" />
		<add key="DienThoaiTrungTam" value="0292.3888.999" />
		<add key="EmailTrungTam" value="contact@tinhocngoisaoviet.edu.vn" />
	</appSettings>
	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.7.2" maxRequestLength="102400" />
		<sessionState mode="InProc" timeout="60" />
		<globalization culture="vi-VN" uiCulture="vi-VN" />
	</system.web>

	<system.webServer>
		<defaultDocument>
			<files>
				<clear />
				<add value="Login.aspx" />
			</files>
		</defaultDocument>
	</system.webServer>
</configuration>